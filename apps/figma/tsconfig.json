{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true,
    "typeRoots": ["../../node_modules/@types", "../../node_modules/@figma"],
    "types": ["node", "plugin-typings"]
  },
  "include": ["src", "test"]
}
