{
  "$schema": "https://www.designtokens.org/schemas/2025.10/resolver.json",
  "name": "Dualkit Starter, Figma",
  "version": "2025.10",
  "description": "The Starter token files plus Figma text styles. Styles only exist for Figma: their size binds the Script variable, so it follows the en and ar modes.",
  "sets": {
    "primitives": {
      "sources": [
        {
          "$ref": "../../../../packages/starter/tokens/primitives/color.json"
        },
        {
          "$ref": "../../../../packages/starter/tokens/primitives/dimension.json"
        },
        {
          "$ref": "../../../../packages/starter/tokens/primitives/font.json"
        }
      ]
    },
    "semantic": {
      "sources": [
        {
          "$ref": "../../../../packages/starter/tokens/semantic/color.json"
        },
        {
          "$ref": "../../../../packages/starter/tokens/semantic/space.json"
        },
        {
          "$ref": "../../../../packages/starter/tokens/semantic/motion.json"
        },
        {
          "$ref": "styles.json"
        }
      ]
    },
    "script": {
      "sources": [
        {
          "$ref": "../../../../packages/starter/tokens/script/type.json"
        }
      ],
      "$extensions": {
        "com.figma": {
          "collection": "Script"
        }
      }
    }
  },
  "modifiers": {
    "theme": {
      "contexts": {
        "light": [],
        "dark": [
          {
            "$ref": "../../../../packages/starter/tokens/modifiers/theme/dark.json"
          }
        ]
      },
      "default": "light"
    },
    "script": {
      "contexts": {
        "en": [],
        "ar": [
          {
            "$ref": "../../../../packages/starter/tokens/modifiers/script/ar.json"
          }
        ]
      },
      "default": "en",
      "$extensions": {
        "com.figma": {
          "collection": "Script"
        }
      }
    }
  },
  "resolutionOrder": [
    {
      "$ref": "#/sets/primitives"
    },
    {
      "$ref": "#/sets/semantic"
    },
    {
      "$ref": "#/sets/script"
    },
    {
      "$ref": "#/modifiers/script"
    },
    {
      "$ref": "#/modifiers/theme"
    }
  ]
}