ontainer = document.getElementById('modal-fields-container');\n    const toast = document.getElementById('toast');\n    const toastMessage = document.getElementById('toast-message');\n\n    function openEditModal(type, title, val1, val2) {\n      modalTitle.textContent = 'تعديل ' + title;\n      fieldsContainer.innerHTML = '';\n\n      if (type === 'name') {\n        fieldsContainer.innerHTML = `\n          <div>\n            <label class=\"block text-sm font-semibold text-slate-700 mb-1.5 ar-floor\">الاسم الكامل</label>\n            <!-- dir=\"auto\" allows both Arabic and Latin characters without distortion -->\n            <input type=\"text\" dir=\"auto\" required value=\"${val1}\" class=\"w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:border-sky-500 text-slate-900 text-base font-medium ar-floor\">\n          </div>\n          <div>\n            <label class=\"block text-sm font-semibold text-slate-700 mb-1.5 ar-floor\">البريد الإلكتروني</label>\n            <!-- Email is fixed format -> dir=\"ltr\" -->\n            <input type=\"email\" dir=\"ltr\" inputmode=\"email\" required value=\"${val2}\" class=\"w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:border-sky-500 text-slate-900 text-base font-medium text-start\">\n          </div>\n        `;\n      } else if (type === 'phone') {\n        fieldsContainer.innerHTML = `\n          <div>\n            <label class=\"block text-sm font-semibold text-slate-700 mb-1.5 ar-floor\">رقم الهاتف المتحرك (دولة الإمارات)</label>\n            <!-- Phone input placed in LTR container for country code prefix + typing -->\n            <div dir=\"ltr\" class=\"flex items-center rounded-xl border border-slate-300 focus-within:border-sky-500 overflow-hidden bg-white\">\n              <span class=\"px-3 py-2.5 bg-slate-100 text-slate-600 font-semibold text-sm border-e border-slate-200 select-none\">\n                +971\n              </span>\n              <input type=\"tel\" inputmode=\"tel\" required value=\"50 123 4567\" placeholder=\"50 123 4567\" class=\"w-full px-3 py-2.5 text-slate-900 text-base font-medium tracking-wide focus:outline-none\">\n            </div>\n            <p class=\"text-xs text-slate-500 mt-1.5\">مثال: <bdi dir=\"ltr\">050 123 4567</bdi> أو <bdi dir=\"ltr\">50 123 4567</bdi></p>\n          </div>\n        `;\n      } else if (type === 'iban') {\n        fieldsContainer.innerHTML = `\n          <div>\n            <label class=\"block text-sm font-semibold text-slate-700 mb-1.5 ar-floor\">رقم الحساب المصرفي الدولي (IBAN)</label>\n            <!-- IBAN is strictly LTR, grouped in 4s -->\n            <input type=\"text\" dir=\"ltr\" inputmode=\"text\" required value=\"${val1}\" class=\"w-full px-3.5 py-2.5 rounded-xl border border-slate-300 focus:border-sky-500 text-slate-900 text-sm font-mono tracking-wider\">\n            <p class=\"text-xs text-slate-500 mt-1.5\">يجب أن يتكون آيبان دولة الإمارات من 23 خانة ويبدأ بالرمز <bdi dir=\"ltr\">AE</bdi></p>\n          </div>\n        `;\n      }\n\n      editModal.classList.remove('hidden');\n    }\n\n    function closeEditModal() {\n      editModal.classList.add('hidden');\n    }\n\n    function showToast(text) {\n      toastMessage.textContent = text;\n      toast.classList.remove('opacity-0', 'pointer-events-none');\n      setTimeout(() => {\n        toast.classList.add('opacity-0', 'pointer-events-none');\n      }, 3500);\n    }\n\n    function handleFormSubmit(e) {\n      e.preventDefault();\n      closeEditModal();\n      showToast('تم إرسال طلب التعديل ورمز التحقق بنجاح');\n    }\n\n    // Close modal on outside click\n    editModal.addEventListener('click', (e) => {\n      if (e.target === editModal) {\n        closeEditModal();\n      }\n    });\n  </script>\n</body>\n</html>\n```",
