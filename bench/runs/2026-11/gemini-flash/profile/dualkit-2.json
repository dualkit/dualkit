      </section>\n\n      <!-- Security / Emirates ID Information Box -->\n      <section class=\"bg-gradient-to-r from-slate-900 to-slate-800 rounded-3xl p-4 sm:p-5 text-white shadow-lg relative overflow-hidden\">\n        <div class=\"absolute -end-6 -bottom-6 w-28 h-28 bg-sky-500/10 rounded-full blur-2xl\"></div>\n        <div class=\"flex items-start gap-3.5 relative z-10\">\n          <div class=\"w-9 h-9 rounded-xl bg-white/10 flex items-center justify-center flex-shrink-0 text-sky-300\">\n            <svg class=\"w-5 h-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z\" />\n            </svg>\n          </div>\n          <div class=\"space-y-1\">\n            <h4 class=\"text-sm font-bold text-white ar-floor\">الحساب محمي بالهوية الإماراتية</h4>\n            <!-- Sensitive ID masked according to standards -->\n            <p class=\"text-sm text-slate-300 font-normal ar-floor\">\n              رقم الهوية: <bdi dir=\"ltr\" class=\"tabular-data font-mono tracking-wider font-semibold text-sky-200\">784-****-*******-6</bdi>\n            </p>\n            <p class=\"text-xs text-slate-400 mt-1 leading-relaxed\">\n              تتم المصادقة على جميع تعديلات الدفع عبر تطبيق <bdi>UAE PASS</bdi> لضمان أعلى معايير الأمان المالي.\n            </p>\n          </div>\n        </div>\n      </section>\n\n    </div>\n\n    <!-- Bottom Navigation Bar -->\n    <nav aria-label=\"شريط التنقل الرئيسي\" class=\"bg-white border-t border-slate-200/80 px-6 py-2.5 flex items-center justify-between\">\n      <button type=\"button\" class=\"flex flex-col items-center gap-1 text-slate-400 hover:text-slate-600 transition-colors\">\n        <svg class=\"w-6 h-6\" fill=\"none\" viewBox=\"0 0 24