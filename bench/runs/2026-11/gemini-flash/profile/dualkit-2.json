rounded-full bg-sky-600 ring-2 ring-white\"></span>\n        </div>\n        <span class=\"ar-floor font-bold leading-none\">حسابي</span>\n      </button>\n    </nav>\n  </main>\n\n  <!-- Interactive Edit Modal Sheet (Demonstrating correct bidi & field behaviour) -->\n  <div id=\"edit-modal\" class=\"fixed inset-0 bg-slate-950/70 backdrop-blur-sm z-50 flex items-end sm:items-center justify-center p-0 sm:p-4 hidden\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"modal-title\">\n    <div class=\"bg-white w-full sm:max-w-md rounded-t-[32px] sm:rounded-3xl p-6 shadow-2xl border border-slate-200 transition-all transform animate-in fade-in slide-in-from-bottom duration-200\">\n      <div class=\"w-12 h-1.5 bg-slate-200 rounded-full mx-auto mb-4 sm:hidden\"></div>\n      \n      <div class=\"flex items-center justify-between pb-3 border-b border-slate-100 mb-4\">\n        <h3 id=\"modal-title\" class=\"text-base font-bold text-slate-900 ar-floor\">تعديل البيانات</h3>\n        <button \n          type=\"button\" \n          onclick=\"closeEditModal()\" \n          class=\"text-slate-400 hover:text-slate-600 p-1.5 rounded-full hover:bg-slate-100 transition-colors\"\n          aria-label=\"إغلاق النافذة\">\n          <svg class=\"w-5 h-5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 18L18 6M6 6l12 12\" />\n          </svg>\n        </button>\n      </div>\n\n      <form id=\"edit-form\" onsubmit=\"handleFormSubmit(event)\" class=\"space-y-4\">\n        <div id=\"modal-fields-container\" class=\"space-y-3\">\n          <!-- Dynamically inserted input rows based on action -->\n        </div>\n\n        <div class=\"p-3 bg-amber-50 rounded-xl border border-amber-200/80 text-amber-900 text-sm ar-floor flex items-start gap-2.5\">\n          <svg class=\"w-5 h-5 text-amber-600 flex-shrink-0 mt-0.5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n  