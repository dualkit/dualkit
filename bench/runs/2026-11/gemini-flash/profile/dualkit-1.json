ss=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" viewBox=\"0 0 24 24\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z\" />\n            </svg>\n          </div>\n          <div>\n            <span class=\"block text-slate-300 font-medium caption-floor\">بطاقة الهوية الإماراتية</span>\n            <!-- Masked Emirates ID with LTR direction -->\n            <p class=\"caption-floor text-slate-400\">\n              <bdi dir=\"ltr\" class=\"tabular-nums\">784-1994-*******-3</bdi>\n            </p>\n          </div>\n        </div>\n        <span class=\"text-xs px-2.5 py-1 rounded-full bg-slate-800 text-slate-300 border border-slate-700/60 font-medium\">سارية</span>\n      </section>\n\n      <!-- Logout / Action (Neutral verbal noun) -->\n      <div class=\"pt-2 pb-4\">\n        <button type=\"button\" class=\"w-full py-3.5 px-4 rounded-2xl border border-red-500/20 bg-red-950/20 hover:bg-red-950/40 text-red-400 text-sm font-semibold transition-colors flex items-center justify-center gap-2\">\n          <!-- Non-directional logout signout -->\n          <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75\" />\n          </svg>\n          <span>تسجيل الخروج</span>\n        </button>\n      </div>\n\n    </div>\n\n    <!-- Interactive Edit Bottom Sheet / Modal -->\n    <div \n      id=\"editModal\" \n      class=\"fixed inset-0 z-50 bg-black/70 backdrop-blur-xs hidden opacity-0 transition-opacity flex items-end sm:items-center justify-center p-0 sm:p-4\"\n      aria-hidden=\"true\"\n      role=\"dialog\"\n      aria-labelledby=\"modalTitle\"\n    >\n      <div \n        id=\"modalContent\"\n        class=\"w-full max-w-md bg-slate-900 border border-slate-800 rounded-t-3xl sm:rounded-3xl p-6 shadow-2xl translate-y-8 sheet-transition\"\n      >\n        <div class=\"flex items-center justify-between pb-4 border-b border-slate-800\">\n          <h3 id=\"modalTitle\" class=\"text-lg font-bold text-white\">تعديل البيانات</h3>\n          <button \n            type=\"button\" \n            onclick=\"closeEditor()\" \n            aria-label=\"إغلاق\"\n            class=\"p-1 rounded-full text-slate-400 hover:text-white hover:bg-slate-800 transition-colors\"\n          >\n            <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 18L18 6M6 6l12 12\" />\n            </svg>\n          </button>\n        </div>\n\n        <form id=\"editForm\" onsubmit=\"handleFormSubmit(event)\" class=\"mt-4 space-y-4\">\n          <div id=\"dynamicFields\" class=\"space-y-4\">\n            <!-- Dynamically injected fields -->\n          </div>\n\n          <p class=\"caption-floor text-slate-400 pt-1\">\n            قد يتطلب اعتماد التعديلات إدخال رمز التحقق لمرة واحدة (OTP) لضمان أمان حسابك.\n          </p>\n\n          <div class=\"flex items-center gap-3 pt-3\">\n            <button \n              type=\"submit\" \n              class=\"flex-1 py-3 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 active:bg-emerald-700 text-slate-950 font-semibold transition-colors text-base\"\n            >\n              حفظ التغييرات\n            </button>\n            <button \n              type=\"button\" \n              onclick=\"closeEditor()\" \n              class=\"py-3 px-4 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold transition-colors text-base\"\n            >\n              إلغاء\n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n\n    <!-- Toast feedback message -->\n    <div \n      id=\"toast\" \n      class=\"fixed bottom-6 inset-x-6 sm:inset-x-auto sm:start-1/2 sm:-translate-x-1/2 z-50 bg-emerald-600 text-slate-950 px-4 py-3 rounded-xl shadow-lg font-semibold text-center caption-floor opacity-0 pointer-events-none transition-all duration-300 flex items-center justify-center gap-2\"\n    >\n      <svg class=\"w-5 h-5 shrink-0\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n        <path fill-rule=\"evenodd\" d=\"M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z\" clip-rule=\"evenodd\"/>\n      </svg>\n      <span id=\"toastMsg\">تم التحديث بنجاح</span>\n    </div>\n\n  </main>\n\n  <script>\n    // Copy IBAN feedback function\n    function copyIban(text) {\n      navigator.clipboard.writeText(text).then(() => {\n        const copyText = document.getElementById('copyText');\n        copyText.textContent = 'تم النسخ!';\n        showToast('تم نسخ رقم الآيبان إلى الحافظة');\n        setTimeout(() => {\n          copyText.textContent = 'نسخ الآيبان';\n        }, 2200);\n      }).catch(() => {\n        showToast('تعذر النسخ تلقائياً');\n      });\n    }\n\n    // Modal Sheet Management\n    const editModal = document.getElementById('editModal');\n    const modalContent = document.getElementById('modalContent');\n    const modalTitle = document.getElementById('modalTitle');\n    const dynamicFields = document.getElementById('dynamicFields');\n\n    function openEditor(type, title, val1, val2) {\n      modalTitle.textContent = 'تعديل ' + title;\n      dynamicFields.innerHTML = '';\n\n      if (type === 'name_email') {\n        dynamicFields.innerHTML = `\n          <div>\n            <label class=\"block text-slate-300 caption-floor font-medium mb-1.5\" for=\"nameInput\">الاسم الكامل</label>\n            <input \n              id=\"nameInput\" \n              type=\"text\" \n              dir=\"auto\" \n              value=\"${val1}\"\n              required \n              class=\"w-full px-3.5 py-2.5 rounded-xl bg-slate-800 border border-slate-700 text-white focus:outline-none focus:border-emerald-500 text-base\"\n            />\n          </div>\n          <div>\n            <label class=\"block text-slate-300 caption-floor font-medium mb-1.5\" for=\"emailInput\">البريد الإلكتروني</label>\n            <input \n              id=\"emailInput\" \n              type=\"email\" \n              dir=\"ltr\" \n              inputmode=\"email\"\n              value=\"${val2}\"\n              required \n              class=\"w-full px-3.5 py-2.5 rounded-xl bg-slate-800 border border-slate-700 text-white focus:outline-none focus:border-emerald-500 text-base text-start\"\n            />\n          </div>\n        `;\n      } else if (type === 'phone') {\n        dynamicFields.innerHTML = `\n          <div>\n            <label class=\"block text-slate-300 caption-floor font-medium mb-1.5\" for=\"phoneInput\">رقم الهاتف المتحرك في الإمارات</label>\n            <div class=\"flex items-center rounded-xl bg-slate-800 border border-slate-700 focus-within:border-emerald-500 overflow-hidden\" dir=\"ltr\">\n              <span class=\"px-3.5 py-2.5 bg-slate-800/80 text-slate-400 border-e border-slate-700 font-mono text-sm\">+971</span>\n              <input \n                id=\"phoneInput\" \n                type=\"tel\" \n                dir=\"ltr\" \n                inputmode=\"tel\" \n                placeholder=\"50 123 4567\" \n                value=\"50 123 4567\" \n                required \n                class=\"w-full px-3.5 py-2.5 bg-transparent text-white focus:outline-none text-base\"\n              />\n            </div>\n            <p class=\"caption-floor text-slate-400 mt-1.5\">\n              مثال: <bdi dir=\"ltr\">050 123 4567</bdi>\n            </p>\n          </div>\n        `;\n      } else if (type === 'iban') {\n        dynamicFields.innerHTML = `\n          <div>\n            <label class=\"block text-slate-300 caption-floor font-medium mb-1.5\" for=\"ibanInput\">رقم الحساب المصرفي الدولي (IBAN)</label>\n            <input \n              id=\"ibanInput\" \n              type=\"text\" \n              dir=\"ltr\" \n              inputmode=\"text\" \n              maxlength=\"27\"\n              value=\"${val1}\"\n              required \n              class=\"w-full font-mono px-3.5 py-2.5 rounded-xl bg-slate-800 border border-slate-700 text-emerald-300 focus:outline-none focus:border-emerald-500 text-sm sm:text-base text-start\"\n            />\n            <p class=\"caption-floor text-slate-400 mt-1.5\">\n              يبدأ بـ <bdi dir=\"ltr\">AE</bdi> ويليه 21 رقماً.\n            </p>\n          </div>\n        `;\n      }\n\n      editModal.classList.remove('hidden');\n      requestAnimationFrame(() => {\n        editModal.classList.remove('opacity-0');\n        modalContent.classList.remove('translate-y-8');\n      });\n      document.body.style.overflow = 'hidden';\n    }\n\n    function closeEditor() {\n      editModal.classList.add('opacity-0');\n      modalContent.classList.add('translate-y-8');\n      setTimeout(() => {\n        editModal.classList.add('hidden');\n        document.body.style.overflow = '';\n      }, 250);\n    }\n\n    function handleFormSubmit(e) {\n      e.preventDefault();\n      closeEditor();\n      showToast('تم حفظ التعديلات بنجاح');\n    }\n\n    function showToast(message) {\n      const toast = document.getElementById('toast');\n      const toastMsg = document.getElementById('toastMsg');\n      toastMsg.textContent = message;\n      toast.classList.remove('opacity-0', 'pointer-events-none');\n      toast.classList.add('opacity-100');\n      \n      setTimeout(() => {\n        toast.classList.remove('opacity-100');\n        toast.classList.add('opacity-0', 'pointer-events-none');\n      }, 2600);\n    }\n  </script>\n</body>\n</html>\n```",
