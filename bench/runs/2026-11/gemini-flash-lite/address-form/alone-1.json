w.w3.org/2000/svg\" class=\"h-6 w-6 text-emerald-600 shrink-0\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z\" />\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M15 11a3 3 0 11-6 0 3 3 0 016 0z\" />\n                    </svg>\n                    <div class=\"text-xs\">\n                        <span class=\"font-bold block\">التوصيل السريع في دبي</span>\n                        أدخل تفاصيل عنوانك بدقة ليصلك الطلب في أسرع وقت.\n                    </div>\n                </div>\n\n                <!-- Emirate Picker -->\n                <div>\n                    <label for=\"emirate\" class=\"block text-xs font-semibold text-gray-600 mb-1.5\">الإمارة</label>\n                    <div class=\"relative\">\n                        <select id=\"emirate\" name=\"emirate\" class=\"w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-gray-800 focus:outline-none focus:border-emerald-600 focus:bg-white appearance-none transition\">\n                            <option value=\"Dubai\" selected>دبي (Dubai)</option>\n                            <option value=\"Abu Dhabi\">أبوظبي (Abu Dhabi)</option>\n                            <option value=\"Sharjah\">الشارقة (Sharjah)</option>\n                            <option value=\"Ajman\">عجمان (Ajman)</option>\n                            <option value=\"Umm Al Quwain\">أم القيوين (Umm Al Quwain)</option>\n                            <option value=\"Ras Al Khaimah\">رأس الخيمة (Ras Al Khaimah)</option>\n                            <option value=\"Fujairah\">الفجيرة (Fujairah)</option>\n                        </select>\n                        <div class=\"absolute inset-y-0 left-0 flex items-center px-4 pointer-events-none text-gray-500\">\n                            <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\"></path>\n                            </svg>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Area -->\n                <div>\n                    <label for=\"area\" class=\"block text-xs font-semibold text-gray-600 mb-1.5\">المنطقة / الحي</label>\n                    <input type=\"text\" id=\"area\" placeholder=\"مثال: بر دبي، دبي مارينا، داون تاون\" required\n                        class=\"w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-gray-800 placeholder-gray-400 focus:outline-none focus:border-emerald-600 focus:bg-white transition\">\n                </div>\n\n                <!-- Street -->\n                <div>\n                    <label for=\"street\" class=\"block text-xs font-semibold text-gray-600 mb-1.5\">الشارع</label>\n                    <input type=\"text\" id=\"street\" placeholder=\"مثال: شارع الشيخ زايد، شارع المركز المالي\" required\n                        class=\"w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-gray-800 placeholder-gray-400 focus:outline-none focus:border-emerald-600 focus:bg-white transition\">\n                </div>\n\n                <!-- Building or Villa -->\n                <div>\n                    <label for=\"building\" class=\"block text-xs font-semibold text-gray-600 mb-1.5\">رقم المبنى أو الفيلا / اسم الشقق</label>\n                    <input type=\"text\" id=\"building\" placeholder=\"مثال: برج الروضة، شقة رقم 402، أو فيﻼ 12\" required\n                        class=\"w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-gray-800 placeholder-gray-400 focus:outline-none focus:border-emerald-600 focus:bg-white transition\">\n                </div>\n\n                <!-- Makani Number -->\n                <div>\n                    <div class=\"flex justify-between items-center mb-1.5\">\n                        <label for=\"makani\" class=\"block text-xs font-semibold text-gray-600\">رقم المكاني (اختياري)</label>\n                        <span class=\"text-[10px] text-gray-400\">10 أرقام</span>\n                    </div>\n                    <input type=\"text\" id=\"makani\" maxlength=\"10\" placeholder=\"مثال: 30004 95821\"\n                        class=\"w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-gray-800 placeholder-gray-400 focus:outline-none focus:border-emerald-600 focus:bg-white transition tracking-widest\">\n                </div>\n\n                <!-- Phone Number -->\n                <div>\n                    <label for=\"phone\" class=\"block text-xs font-semibold text-gray-600 mb-1.5\">رقم الهاتف للتواصل</label>\n                    <div class=\"relative flex items-center\">\n                        <span class=\"absolute right-4 text-gray-500 font-medium text-sm\">+971</span>\n                        <input type=\"tel\" id=\"phone\" placeholder=\"050 123 4567\" required\n                            class=\"w-full bg-gray-50 border border-gray-200 rounded-xl pr-16 pl-4 py-3 text-gray-800 placeholder-gray-400 focus:outline-none focus:border-emerald-600 focus:bg-white transition text-left dir-ltr\">\n                    </div>\n                    <p class=\"text-[11px] text-gray-400 mt-1\">سيتصل بك السائق على هذا الرقم عند الوصول.</p>\n                </div>\n\n            </form>\n        </main>\n\n        <!-- Footer Button -->\n        <footer class=\"bg-white px-5 py-4 border-t border-gray-100\">\n            <button type=\"submit\" form=\"addressForm\"\n                class=\"w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3.5 px-4 rounded-xl shadow-lg shadow-emerald-600/20 transition active:scale-[0.98]\">\n                حفظ العنوان\n            </button>\n        </footer>\n\