\"p-6 space-y-5 flex-1 overflow-y-auto\">\n            \n            <!-- Map Banner Hint -->\n            <div class=\"bg-grocery-50 border border-grocery-500/30 rounded-2xl p-4 flex items-center space-x-3 space-x-reverse\">\n                <div class=\"bg-grocery-500 text-white p-2.5 rounded-xl\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-6 w-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z\" />\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M15 11a3 3 0 11-6 0 3 3 0 016 0z\" />\n                    </svg>\n                </div>\n                <div>\n                    <h2 class=\"text-sm font-bold text-gray-800\">توصيل سريع إلى موقعك</h2>\n                    <p class=\"text-xs text-gray-500\">يرجى إدخال تفاصيل العنوان بدقة لضمان وصول طلبك في الوقت المحدد.</p>\n                </div>\n            </div>\n\n            <form id=\"addressForm\" class=\"space-y-4\">\n                \n                <!-- Emirate Picker -->\n                <div>\n                    <label class=\"block text-xs font-semibold text-gray-600 mb-1.5\">الإمارة</label>\n                    <div class=\"relative\">\n                        <select class=\"w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm text-gray-800 appearance-none focus:outline-none focus:border-grocery-500 focus:bg-white transition\">\n                            <option value=\"Dubai\" selected>دبي</option>\n                            <option value=\"Abu Dhabi\">أبوظبي</option>\n                            <option value=\"Sharjah\">الشارقة</option>\n                            <option value=\"Ajman\">عجمان</option>\n                            <option value=\"Umm Al Quwain\">أم القيوين</option>\n                            <option value=\"Ras Al Khaimah\">رأس الخيمة</option>\n                            <option value=\"Fujairah\">الفجيرة</option>\n                        </select>\n                        <div class=\"absolute inset-y-0 left-0 flex items-center px-4 pointer-events-none text-gray-500\">\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-4 w-4\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\" />\n                            </svg>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Area -->\n                <div>\n                    <label class=\"block text-xs font-semibold text-gray-600 mb-1.5\">المنطقة / الحي</label>\n                    <input type=\"text\" placeholder=\"مثال: دبي مارينا، البرشاء، داون تاون\" \n                        class=\"w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm text-gray-800 focus:outline-none focus:border-grocery-500 focus:bg-white transition\" required>\n                </div>\n\n                <!-- Street -->\n                <div>\n                    <label class=\"block text-xs font-semibold text-gray-600 mb-1.5\">الشارع</label>\n                    <input type=\"text\" placeholder=\"مثال: شارع الشيخ زايد، شارع الأصايل\" \n                        class=\"w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm text-gray-800 focus:outline-none focus:border-grocery-500 focus:bg-white transition\" required>\n                </div>\n\n                <!-- Building or Villa -->\n                <div>\n                    <label class=\"block text-xs font-semibold text-gray-600 mb-1.5\">المبنى أو الفيلا ورقم الشقة</label>\n                    <input type=\"text\" placeholder=\"مثال: برج الروضة، شقة رقم 402، أو فيﻼ 12\" \n                        class=\"w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm text-gray-800 focus:outline-none focus:border-grocery-500 focus:bg-white transition\" required>\n                </div>\n\n                <!-- Makani Number -->\n                <div>\n                    <div class=\"flex justify-between items-center mb-1.5\">\n                        <label class=\"block text-xs font-semibold text-gray-600\">رقم مكاني (اختياري)</label>\n                        <span class=\"text-[10px] text-gray-400\">10 أرقام مميزة للموقع</span>\n                    </div>\n                    <input type=\"text\" maxlength=\"10\" placeholder=\"مثال: 30492 92810\" \n                        class=\"w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm text-gray-800 focus:outline-none focus:border-grocery-500 focus:bg-white transition tracking-widest\">\n                </div>\n\n                <!-- Phone Number -->\n                <div>\n                    <label class=\"block text-xs font-semibold text-gray-600 mb-1.5\">رقم الهاتف للتواصل</label>\n                    <div class=\"relative flex\">\n                        <span class=\"inline-flex items-center px-3 rounded-r-xl border border-l-0 border-gray-200 bg-gray-100 text-gray-500 text-sm\">\n                            🇦🇪 +971\n                        </span>\n                        <input type=\"tel\" placeholder=\"050 123 4567\" \n                            class=\"flex-1 bg-gray-50 border border-gray-200 rounded-l-xl px-4 py-3 text-sm text-gray-800 focus:outline-none focus:border-grocery-500 focus:bg-white transition\" required>\n                    </div>\n                </div>\n\n            </form>\n        </div>\n\n        <!-- Footer Action -->\n        <div class=\"p-6 bg-white border-t border-gray-100\">\n            <button type=\"submit\" form=\"addressForm\" \n                class=\"w-full bg-grocery-600 hover:bg-grocery-700 active:scale-[0.99] text-white font-bold py-3.5 px-4 rounded-2xl