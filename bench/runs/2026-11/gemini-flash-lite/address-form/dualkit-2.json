- Spacer for balance -->\n    </header>\n\n    <!-- Form Body -->\n    <main class=\"p-5 flex-1 space-y-5\">\n      \n      <!-- Notice / Banner -->\n      <div class=\"bg-emerald-50 border border-emerald-100 rounded-2xl p-4 flex items-start gap-3\">\n        <svg class=\"w-5 h-5 text-emerald-600 shrink-0 mt-0.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" viewBox=\"0 0 24 24\">\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z\"></path>\n          <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M15 11a3 3 0 11-6 0 3 3 0 016 0z\"></path>\n        </svg>\n        <p class=\"text-xs text-emerald-800 ar-text-floor\">\n          حدد موقعك بدقة لضمان توصيل طلب البقالة طازجاً وبسرعة إلى باب منزلك.\n        </p>\n      </div>\n\n      <form id=\"addressForm\" class=\"space-y-4\">\n        \n        <!-- Emirate Picker -->\n        <div class=\"space-y-1.5\">\n          <label for=\"emirate\" class=\"block text-sm font-medium text-gray-700 ar-text-floor\">الإمارة</label>\n          <div class=\"relative\">\n            <select id=\"emirate\" name=\"emirate\" class=\"w-full appearance-none bg-gray-50 border border-gray-200 rounded-xl px-4 py-3.5 pe-10 text-sm ar-text-floor focus:outline-none focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 transition-all\">\n              <option value=\"DXB\" selected>دبي (Dubai)</option>\n              <option value=\"AUH\">أبوظبي (Abu Dhabi)</option>\n              <option value=\"SHJ\">الشارقة (Sharjah)</option>\n              <option value=\"AJM\">عجمان (Ajman)</option>\n              <option value=\"UAQ\">أم القيوين (Umm Al Quwain)</option>\n              <option value=\"RAK\">رأس الخيمة (Ras Al Khaimah)</option>\n              <option value=\"FUJ\">الفجيرة (Fujairah)</option>\n            </select>\n            <div class=\"pointer-events-none absolute inset-y-0 start-0 flex items-center px-4 