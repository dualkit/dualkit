<!-- Spacer for alignment -->\n        </div>\n\n        <!-- Form Content -->\n        <div class=\"px-6 py-6 flex-1 overflow-y-auto\">\n            \n            <!-- Location Quick Detect Banner -->\n            <div class=\"bg-brand-50 border border-brand-500/30 rounded-2xl p-4 mb-6 flex items-center gap-4 cursor-pointer hover:bg-brand-50/85 transition\">\n                <div class=\"w-10 h-10 rounded-full bg-brand-500 text-white flex items-center justify-center shrink-0 shadow-sm shadow-brand-500/30\">\n                    <i class=\"fa-solid fa-location-crosshairs text-lg\"></i>\n                </div>\n                <div>\n                    <h3 class=\"text-sm font-bold text-brand-700\">استخدام موقعي الحالي</h3>\n                    <p class=\"text-xs text-gray-500\">تحديد العنوان تلقائياً عبر نظام الجي بي إس</p>\n                </div>\n            </div>\n\n            <form id=\"addressForm\" class=\"space-y-4\">\n                \n                <!-- Emirate Picker -->\n                <div>\n                    <label class=\"block text-xs font-bold text-gray-700 mb-1.5\">الإمارة</label>\n                    <div class=\"relative\">\n                        <select class=\"w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm text-gray-800 focus:outline-none focus:border-brand-500 focus:bg-white transition appearance-none\">\n                            <option value=\"Dubai\" selected>دبي</option>\n                            <option value=\"Abu Dhabi\">أبوظبي</option>\n                            <option value=\"Sharjah\">الشارقة</option>\n                            <option value=\"Ajman\">عجمان</option>\n                            <option value=\"Umm Al Quwain\">أم القيوين</option>\n                            <option value=\"Ras Al Khaimah\">رأس الخيمة</option>\n                            <option value=\"Fujairah\">الفجيرة</option>\n                        </select>\n                        <div class=\"absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none text-gray-400\">\n                            <i class=\"fa-solid fa-chevron-down text-xs\"></i>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Area -->\n                <div>\n                    <label class=\"block text-xs font-bold text-gray-700 mb-1.5\">المنطقة</label>\n                    <input type=\"text\" placeholder=\"مثال: دبي مارينا، البرشاء، الخليج التجاري\" \n                           class=\"w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm text-gray-800 focus:outline-none focus:border-brand-500 focus:bg-white transition\">\n                </div>\n\n                <!-- Street -->\n                <div>\n                    <label class=\"block text-xs font-bold text-gray-700 mb-1.5\">الشارع</label>\n                    <input type=\"text\" placeholder=\"مثال: شارع الموهبة، شارع الشيخ زايد\" \n                           class=\"w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm text-gray-800 focus:outline-none focus:border-brand-500 focus:bg-white transition\">\n                </div>\n\n                <!-- Building or Villa -->\n                <div>\n                    <label class=\"block text-xs font-bold text-gray-700 mb-1.5\">المبنى أو الفيلا</label>\n                    <input type=\"text\" placeholder=\"اسم المبنى أو رقم الفيلا، رقم الشقة\" \n                           class=\"w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm text-gray-800 focus:outline-none focus:border-brand-500 focus:bg-white transition\">\n                </div>\n\n                <!-- Makani Number -->\n                <div>\n                    <div class=\"flex justify-between items-center mb-1.5\">\n                        <label class=\"block text-xs font-bold text-gray-700\">رقم مكاني (Makani)</label>\n                        <span class=\"text-[10px] text-gray-400 bg-gray-100 px-2 py-0.5 rounded-full\">اخ