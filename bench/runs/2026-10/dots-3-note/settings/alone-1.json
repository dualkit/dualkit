e\"><span>العربية</span><span class=\"chevron\">›</span></div>\n    </div>\n  </div>\n\n  <!-- Security Group -->\n  <div class=\"group\">\n    <div class=\"group-title\">الأمان</div>\n    <div class=\"row\">\n      <div class=\"row-label\">Face ID</div>\n      <label class=\"toggle\">\n        <input type=\"checkbox\" checked>\n        <span class=\"slider\"></span>\n      </label>\n    </div>\n    <div class=\"row\">\n      <div class=\"row-label\">تسجيل الدخول بخطوتين</div>\n      <label class=\"toggle\">\n        <input type=\"checkbox\">\n        <span class=\"slider\"></span>\n      </label>\n    </div>\n  </div>\n\n  <!-- Notifications Group -->\n  <div class=\"group\">\n    <div class=\"group-title\">الإشعارات</div>\n    <div class=\"row\">\n      <div class=\"row-label\">الحوالت</div>\n      <label class=\"toggle\">\n        <input type=\"checkbox\" checked>\n        <span class=\"slider\"></span>\n      </label>\n    </div>\n    <div class=\"row\">\n      <div class=\"row-label\">Offers</div>\n      <label class=\"toggle\">\n        <input type=\"checkbox\">\n        <span class=\"slider\"></span>\n      </label>\n    </div>\n    <div class=\"row\">\n      <div class=\"row-label\">الكشوف</div>\n      <label class=\"toggle\">\n        <input type=\"checkbox\" checked>\n        <span class=\"slider\"></span>\n      </label>\n    </div>\n  </div>\n</div>\n</body>\n</html>\n```",
