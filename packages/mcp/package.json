{
  "name": "@dualkit/mcp",
  "version": "0.1.0-beta.0",
  "description": "An MCP server that gives coding agents Dualkit's Gulf formats, validators and Arabic and right-to-left rules.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "dualkit-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "arabic",
    "rtl",
    "gulf",
    "iban",
    "hijri",
    "agents"
  ],
  "author": "Sam Santos (https://snts.im)",
  "homepage": "https://dualkit.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dualkit/dualkit.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/dualkit/dualkit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "devDependencies": {
    "@types/jsdom": "^27.0.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.7",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@dualkit/format": "0.2.0-beta.0",
    "@dualkit/rules": "0.5.0-beta.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "jsdom": "^27.4.0",
    "zod": "^4.6.7"
  }
}
