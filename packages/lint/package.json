{
  "name": "@dualkit/lint",
  "version": "0.4.0-beta.0",
  "description": "Source rules that catch Arabic and right-to-left bugs before anything renders.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "LINT.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@babel/parser": "^7.29.9",
    "@babel/types": "^7.29.8",
    "@dualkit/rules": "0.5.0-beta.0",
    "ignore": "^7.0.13",
    "parse5": "^7.3.0",
    "postcss": "^8.5.31",
    "postcss-scss": "^4.0.9",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^3.2.7",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "keywords": ["arabic", "rtl", "bidi", "lint", "css", "jsx", "gulf"],
  "author": "Sam Santos (https://snts.im)",
  "homepage": "https://dualkit.dev",
  "repository": { "type": "git", "url": "git+https://github.com/dualkit/dualkit.git", "directory": "packages/lint" },
  "bugs": { "url": "https://github.com/dualkit/dualkit/issues" },
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=18.18" }
}
