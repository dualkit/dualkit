{
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": {
          "value": 120,
          "unit": "ms"
        }
      },
      "base": {
        "$value": {
          "value": 200,
          "unit": "ms"
        }
      },
      "slow": {
        "$value": {
          "value": 400,
          "unit": "ms"
        }
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [
          0.2,
          0,
          0,
          1
        ]
      },
      "out": {
        "$value": [
          0.16,
          1,
          0.3,
          1
        ]
      }
    }
  }
}
