{
  "name": "@dualkit/format",
  "version": "0.1.0-beta.1",
  "description": "Gulf formats for bilingual products: AED, SAR, QAR, KWD, BHD and OMR, Hijri dates, Arabic numerals, UAE and Saudi phone, Emirates ID, IBAN.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "arabic",
    "rtl",
    "gulf",
    "uae",
    "saudi",
    "qatar",
    "kuwait",
    "bahrain",
    "oman",
    "aed",
    "sar",
    "hijri",
    "iban",
    "emirates-id",
    "i18n"
  ],
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.7",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "author": "Sam Santos (https://snts.im)",
  "homepage": "https://dualkit.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dualkit/dualkit.git",
    "directory": "packages/format"
  },
  "bugs": {
    "url": "https://github.com/dualkit/dualkit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
