{
  "name": "@dualkit/convert",
  "version": "0.1.0-beta.0",
  "description": "Converts an English React or Next.js app to Arabic on a new git branch.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@dualkit/format": "0.2.0-beta.0",
    "@dualkit/lint": "0.4.0-beta.0",
    "@dualkit/rules": "0.5.0-beta.0",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "^3.2.7",
    "postcss": "8.5.31",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "keywords": ["arabic", "rtl", "i18n", "convert", "nextjs", "react", "gulf"],
  "author": "Sam Santos (https://snts.im)",
  "homepage": "https://dualkit.dev",
  "repository": { "type": "git", "url": "git+https://github.com/dualkit/dualkit.git", "directory": "packages/convert" },
  "bugs": { "url": "https://github.com/dualkit/dualkit/issues" },
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=18.18" }
}
